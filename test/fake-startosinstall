#!/bin/sh
set -eu

# shellcheck disable=SC2034
hidden_option_marker=--nointeraction

if [ "${1:-}" = "--usage" ]; then
  printf '%s\n' \
    "--agreetolicense, agree to the license." \
    "--eraseinstall, erase the target volume." \
    "--installpackage, install a package <path>." \
    "--newvolumename, name the new volume." \
    "--rebootdelay, delay reboot by seconds." \
    "--pidtosignal, signal a process after preparing."
  exit 0
fi
printf '%s\n' "$*" >> "$STARTOSINSTALL_LOG"
