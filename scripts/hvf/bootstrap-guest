#!/bin/sh
set -eu

export LC_ALL=C

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  printf '%s\n' "usage: bootstrap-guest INSTALLER.app [output-dir]" >&2
  exit 2
fi
if [ "${DISTILL_GUEST:-0}" != "1" ]; then
  printf '%s\n' "bootstrap-guest: set DISTILL_GUEST=1 inside the macOS guest" >&2
  exit 1
fi
if [ "$(uname -s)" != "Darwin" ]; then
  printf '%s\n' "bootstrap-guest: startosinstall must run in macOS" >&2
  exit 1
fi

installer=$1
output_dir=${2:-out/hvf}
repo_dir=$(cd -- "$(dirname -- "$0")/../.." && pwd)
"$repo_dir/scripts/hvf/installer-capabilities" "$installer" "$output_dir" >/dev/null
capabilities="$output_dir/installer-capabilities.json"
startosinstall="$installer/Contents/Resources/startosinstall"
plutil_cmd=${DISTILL_PLUTIL:-plutil}
command -v "$plutil_cmd" >/dev/null 2>&1 || {
  printf '%s\n' "bootstrap-guest: plutil is required" >&2
  exit 1
}

has_capability() {
  [ "$($plutil_cmd -extract "options.$1" raw -o - "$capabilities" 2>/dev/null)" = "true" ]
}

if ! has_capability agreetolicense; then
  printf '%s\n' "bootstrap-guest: installer lacks --agreetolicense" >&2
  exit 1
fi

set -- --agreetolicense
if has_capability nointeraction; then
  set -- "$@" --nointeraction
fi
if [ "${DISTILL_ERASE_INSTALL:-0}" = "1" ]; then
  has_capability eraseinstall || {
    printf '%s\n' "bootstrap-guest: installer lacks --eraseinstall" >&2
    exit 1
  }
  set -- "$@" --eraseinstall
fi
if [ -n "${DISTILL_INSTALL_VOLUME:-}" ]; then
  has_capability volume || {
    printf '%s\n' "bootstrap-guest: installer lacks --volume" >&2
    exit 1
  }
  set -- "$@" --volume "$DISTILL_INSTALL_VOLUME"
fi
if [ -n "${DISTILL_INSTALL_PACKAGE:-}" ]; then
  has_capability installpackage || {
    printf '%s\n' "bootstrap-guest: installer lacks --installpackage" >&2
    exit 1
  }
  set -- "$@" --installpackage "$DISTILL_INSTALL_PACKAGE"
fi

exec "$startosinstall" "$@"
