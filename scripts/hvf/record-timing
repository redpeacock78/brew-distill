#!/bin/sh
set -eu

export LC_ALL=C

if [ "$#" -ne 3 ]; then
  printf '%s\n' "usage: record-timing OUTPUT.json PHASE SECONDS" >&2
  exit 2
fi
output=$1
phase=$2
seconds=$3

case "$phase" in
  catalog_resolve|installer_download|installer_checksum|installer_pkg_install|installer_discovery|install_media_prepare|bootstrap_pkg_build|installer_tree_copy|install_media_dmg_create|recovery_dmg_convert|firmware_prepare|guest_boot|guest_install|guest_ssh_wait|brew_bootstrap|formula_build|bottle_create|bottle_upload|bottle_verify) ;;
  *)
    printf '%s\n' "record-timing: unsupported phase: $phase" >&2
    exit 2
    ;;
esac
case "$seconds" in
  ''|*[!0-9]*)
    printf '%s\n' "record-timing: seconds must be a non-negative integer" >&2
    exit 2
    ;;
esac

command -v jq >/dev/null 2>&1 || {
  printf '%s\n' "record-timing: jq is required" >&2
  exit 1
}
mkdir -p "$(dirname -- "$output")"
current='{}'
if [ -s "$output" ]; then
  current=$(cat -- "$output")
  printf '%s\n' "$current" | jq -e 'type == "object"' >/dev/null || {
    printf '%s\n' "record-timing: invalid timing JSON: $output" >&2
    exit 1
  }
fi
tmp="$output.tmp.$$"
printf '%s\n' "$current" | jq \
  --arg phase "$phase" --argjson seconds "$seconds" \
  '. + {schema:1, phases:((.phases // {}) + {($phase): ((.phases[$phase] // 0) + $seconds)})}' \
  > "$tmp"
mv "$tmp" "$output"
printf 'TIMING %s %ss\n' "$phase" "$seconds" >&2
