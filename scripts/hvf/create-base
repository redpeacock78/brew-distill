#!/bin/sh
set -eu

export LC_ALL=C

if [ "$#" -gt 3 ]; then
  printf '%s\n' "usage: create-base [BASE.qcow2] [SIZE] [output-dir]" >&2
  exit 2
fi
base_arg=${1:-${DISTILL_BASE_IMAGE:-out/hvf/base.qcow2}}
size=${2:-${DISTILL_BASE_SIZE:-64G}}
output_dir=${3:-out/hvf}
case "$size" in
  ''|*[!0-9KMGTkmgt]*)
    printf '%s\n' "create-base: invalid image size: $size" >&2
    exit 2
    ;;
esac
base_dir=$(dirname -- "$base_arg")
base_name=$(basename -- "$base_arg")
mkdir -p "$base_dir" "$output_dir"
base=$(cd -- "$base_dir" && pwd)/$base_name
test ! -e "$base" || {
  printf '%s\n' "create-base: image already exists: $base" >&2
  exit 1
}
qemu_img=${QEMU_IMG:-qemu-img}
command -v "$qemu_img" >/dev/null 2>&1 || {
  printf '%s\n' "create-base: qemu-img is required" >&2
  exit 1
}

base_format=${DISTILL_BASE_FORMAT:-qcow2}
case "$base_format" in
  qcow2|raw) ;;
  *)
    printf '%s\n' "create-base: base format must be qcow2 or raw" >&2
    exit 2
    ;;
esac
qcow2_options=${DISTILL_BASE_QCOW2_OPTIONS:-}
if [ "$base_format" = raw ]; then
  [ -z "$qcow2_options" ] || {
    printf '%s\n' "create-base: qcow2 options cannot be used with raw format" >&2
    exit 2
  }
  "$qemu_img" create -f raw "$base" "$size"
else
  case "$qcow2_options" in
    '' )
      "$qemu_img" create -f qcow2 "$base" "$size"
      ;;
    *[!A-Za-z0-9_=,.-]*)
      printf '%s\n' "create-base: invalid qcow2 options: $qcow2_options" >&2
      exit 2
      ;;
    *)
      "$qemu_img" create -f qcow2 -o "$qcow2_options" "$base" "$size"
      ;;
  esac
fi
if command -v jq >/dev/null 2>&1; then
  jq -n --arg base "$base" --arg size "$size" --arg format "$base_format" --arg options "$qcow2_options" \
    '{schema:1,base:$base,size:$size,format:$format,options:(if $options == "" then null else $options end),read_only:false,persistent:false}' \
    > "$output_dir/base-create.json"
fi
printf '%s\n' "base created: $base ($size)"
