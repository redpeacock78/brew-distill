#!/bin/sh
set -eu

export LC_ALL=C

if [ "$#" -ne 3 ]; then
  printf '%s\n' "usage: build-formula FORMULA OVERLAY.qcow2 ARTIFACT-DIR" >&2
  exit 2
fi
formula=$1
overlay=$2
artifact_dir=$3
case "$formula" in
  ''|-*|*[!A-Za-z0-9@+._/-]*)
    printf '%s\n' "build-formula: unsafe formula name: $formula" >&2
    exit 2
    ;;
esac
test -f "$overlay" || {
  printf '%s\n' "build-formula: overlay does not exist: $overlay" >&2
  exit 1
}
mkdir -p "$artifact_dir"
repo_dir=$(cd -- "$(dirname -- "$0")/../.." && pwd)
boot=${DISTILL_GUEST_BOOT:-$repo_dir/scripts/hvf/boot-guest}
ssh_cmd=${DISTILL_SSH:-ssh}
scp_cmd=${DISTILL_SCP:-scp}
target=${DISTILL_GUEST_SSH_TARGET:-distill@127.0.0.1}
port=${DISTILL_GUEST_SSH_PORT:-2222}
ssh_timeout=${DISTILL_GUEST_SSH_TIMEOUT:-600}
safe_name=$(printf '%s' "$formula" | tr '/@+' '___')
guest_dir="/tmp/brew-distill-$safe_name"
guest_pid=

command -v "$ssh_cmd" >/dev/null 2>&1 || {
  printf '%s\n' "build-formula: ssh is required" >&2
  exit 1
}
command -v "$scp_cmd" >/dev/null 2>&1 || {
  printf '%s\n' "build-formula: scp is required" >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  printf '%s\n' "build-formula: jq is required" >&2
  exit 1
}
if [ ! -x "$boot" ]; then
  boot_path=$(command -v "$boot" 2>/dev/null || true)
  [ -n "$boot_path" ] || {
    printf '%s\n' "build-formula: guest boot command is unavailable: $boot" >&2
    exit 1
  }
  boot=$boot_path
fi
case "${HOMEBREW_ARTIFACT_DOMAIN:-}" in
  "") ;;
  http://?*|https://?*)
    case "$HOMEBREW_ARTIFACT_DOMAIN" in
      *[!A-Za-z0-9./:_-]*)
        printf '%s\n' "build-formula: invalid HOMEBREW_ARTIFACT_DOMAIN" >&2
        exit 2
        ;;
    esac
    ;;
  *)
    printf '%s\n' "build-formula: invalid HOMEBREW_ARTIFACT_DOMAIN" >&2
    exit 2
    ;;
esac
if [ "${DISTILL_RELEASE_BUILD:-0}" = "1" ]; then
  case "${HOMEBREW_ARTIFACT_DOMAIN:-}" in
    https://?*) ;;
    *)
      printf '%s\n' "build-formula: release build requires HTTPS HOMEBREW_ARTIFACT_DOMAIN" >&2
      exit 2
      ;;
  esac
  [ "${HOMEBREW_ARTIFACT_DOMAIN_NO_FALLBACK:-0}" = "1" ] || {
    printf '%s\n' "build-formula: release build requires HOMEBREW_ARTIFACT_DOMAIN_NO_FALLBACK=1" >&2
    exit 2
  }
fi

cleanup() {
  if [ -n "$guest_pid" ] && kill -0 "$guest_pid" 2>/dev/null; then
    kill -TERM "$guest_pid" 2>/dev/null || true
    wait "$guest_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT HUP INT TERM

ssh_guest() {
  if [ -n "${DISTILL_GUEST_KNOWN_HOSTS:-}" ]; then
    "$ssh_cmd" -o BatchMode=yes -o UserKnownHostsFile="$DISTILL_GUEST_KNOWN_HOSTS" \
      -p "$port" "$target" "$@"
  else
    "$ssh_cmd" -o BatchMode=yes -o StrictHostKeyChecking=no \
      -o UserKnownHostsFile=/dev/null -p "$port" "$target" "$@"
  fi
}

scp_guest() {
  if [ -n "${DISTILL_GUEST_KNOWN_HOSTS:-}" ]; then
    "$scp_cmd" -o BatchMode=yes -o UserKnownHostsFile="$DISTILL_GUEST_KNOWN_HOSTS" \
      -P "$port" "$@"
  else
    "$scp_cmd" -o BatchMode=yes -o StrictHostKeyChecking=no \
      -o UserKnownHostsFile=/dev/null -P "$port" "$@"
  fi
}

brew_guest() {
  if [ -n "${HOMEBREW_ARTIFACT_DOMAIN:-}" ]; then
    ssh_guest env HOMEBREW_NO_AUTO_UPDATE=1 \
      HOMEBREW_ARTIFACT_DOMAIN="$HOMEBREW_ARTIFACT_DOMAIN" \
      HOMEBREW_ARTIFACT_DOMAIN_NO_FALLBACK="${HOMEBREW_ARTIFACT_DOMAIN_NO_FALLBACK:-0}" \
      brew "$@"
  else
    ssh_guest env HOMEBREW_NO_AUTO_UPDATE=1 brew "$@"
  fi
}

brew_shell() {
  if [ -n "${HOMEBREW_ARTIFACT_DOMAIN:-}" ]; then
    ssh_guest env HOMEBREW_NO_AUTO_UPDATE=1 \
      HOMEBREW_ARTIFACT_DOMAIN="$HOMEBREW_ARTIFACT_DOMAIN" \
      HOMEBREW_ARTIFACT_DOMAIN_NO_FALLBACK="${HOMEBREW_ARTIFACT_DOMAIN_NO_FALLBACK:-0}" \
      sh -c "$1"
  else
    ssh_guest env HOMEBREW_NO_AUTO_UPDATE=1 sh -c "$1"
  fi
}

"$boot" "$overlay" "$artifact_dir" > "$artifact_dir/qemu.log" 2>&1 &
guest_pid=$!
DISTILL_GUEST_INFO="$artifact_dir/guest-info.txt" \
  "$repo_dir/scripts/hvf/wait-ssh" "$target" "$port" "$ssh_timeout"

ssh_guest env HOMEBREW_NO_AUTO_UPDATE=1 mkdir -p "$guest_dir"
brew_guest config > "$artifact_dir/brew-config.txt"
brew_guest doctor > "$artifact_dir/brew-doctor.txt" 2>&1 || true
if [ "$formula" = "csound" ]; then
  scp_guest "$repo_dir/tests/smoke.csd" "$target:$guest_dir/smoke.csd"
fi
brew_guest install --build-bottle --formula "$formula"
brew_guest test "$formula"
brew_guest linkage --test "$formula" \
  > "$artifact_dir/$safe_name.linkage.txt" 2>&1

if [ "$formula" = "csound" ]; then
  csound_prefix=$(brew_guest --prefix "$formula")
  ssh_guest "$csound_prefix/bin/csound" -d -o "$guest_dir/smoke.wav" "$guest_dir/smoke.csd"
  ssh_guest test -s "$guest_dir/smoke.wav"
fi

brew_shell "cd '$guest_dir' && brew bottle --json '$formula'"
scp_guest "$target:$guest_dir/*.bottle*.tar.gz" "$artifact_dir/"
scp_guest "$target:$guest_dir/*.bottle.json" "$artifact_dir/"
bottle=$(find "$artifact_dir" -maxdepth 1 -type f -name "${formula##*/}*.bottle*.tar.gz" -print | sed -n '1p')
test -n "$bottle" || {
  printf '%s\n' "build-formula: no exported Bottle for $formula" >&2
  exit 1
}
bottle_json=$(find "$artifact_dir" -maxdepth 1 -type f -name "${formula##*/}*.bottle.json" -print | sed -n '1p')
test -n "$bottle_json" || {
  printf '%s\n' "build-formula: no exported Bottle JSON for $formula" >&2
  exit 1
}
brew_shell "brew info --json=v2 --formula '$formula' > '$guest_dir/formula-info.json'"
scp_guest "$target:$guest_dir/formula-info.json" "$artifact_dir/"
guest_version=$(ssh_guest sw_vers -productVersion)
guest_build=$(ssh_guest sw_vers -buildVersion)
guest_arch=$(ssh_guest uname -m)
guest_major=${guest_version%%.*}
case "$guest_major" in
  11) guest_tag=big_sur ;;
  12) guest_tag=monterey ;;
  13) guest_tag=ventura ;;
  14) guest_tag=sonoma ;;
  *) guest_tag= ;;
esac
safe_bottle=$(basename -- "$bottle")
guest_platform="$artifact_dir/$safe_name.guest-platform.json"
guest_builder="$artifact_dir/$safe_name.guest-builder.json"
guest_toolchain="$artifact_dir/$safe_name.guest-toolchain.json"
jq -n --arg version "$guest_major" --arg arch "$guest_arch" --arg tag "$guest_tag" \
  '{os:"macos",version:$version,arch:$arch,bottle_tag:$tag}' \
  > "$guest_platform"
jq -n \
  --arg provider "${DISTILL_BUILDER_PROVIDER:-github-hosted}" \
  --arg backend "${DISTILL_BUILDER_BACKEND:-hvf-qemu}" \
  --arg host_runner "${RUNNER_NAME:-macos-15-intel}" \
  --arg guest_version "$guest_version" --arg guest_build "$guest_build" \
  '{provider:$provider,backend:$backend,host_runner:$host_runner,guest_version:$guest_version,guest_build:$guest_build}' \
  > "$guest_builder"
guest_xcode=$(ssh_guest xcodebuild -version 2>/dev/null || true)
guest_clang=$(ssh_guest clang --version 2>/dev/null || true)
guest_sdk=$(ssh_guest xcrun --sdk macosx --show-sdk-version 2>/dev/null || true)
jq -n \
  --arg xcode "$guest_xcode" --arg clang "$guest_clang" --arg sdk "$guest_sdk" \
  --arg macos "$guest_version" --arg build "$guest_build" \
  --arg runner_image "${ImageVersion:-${RUNNER_IMAGE:-}}" \
  '{xcode_version:$xcode,clang_version:$clang,sdk_version:$sdk,deployment_target:"",macos_version:$macos,macos_build:$build,runner_image:$runner_image,libcxx:true}' \
  > "$guest_toolchain"
manifest_path="$artifact_dir/${safe_bottle%.tar.gz}.manifest.json"
formula_info="$artifact_dir/formula-info.json"
"$repo_dir/homebrew-distill" manifest "$formula" \
  --artifact "$bottle" --formula-data "$formula_info" \
  --platform-json "$guest_platform" --builder-json "$guest_builder" \
  --toolchain-json "$guest_toolchain" \
  --output "$manifest_path"
printf '%s\n' "built $formula"
