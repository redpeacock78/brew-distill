  "${DISTILL_QEMU_FIRMWARE_DIR:-}" \
  "$qemu_prefix/share/qemu" "$qemu_prefix/share" \
  /usr/local/share/qemu /opt/homebrew/share/qemu; do
  if [ -z "$firmware_dir" ] || [ ! -d "$firmware_dir" ]; then
    continue
  fi
  if [ -z "$qemu_code" ]; then
    qemu_code=$(find "$firmware_dir" -type f \( -name edk2-x86_64-code.fd -o -name OVMF_CODE.fd \) -print | sed -n '1p')
  fi
  if [ -z "$qemu_vars" ]; then
    qemu_vars=$(find "$firmware_dir" -type f \( -name edk2-x86_64-vars.fd -o -name edk2-i386-vars.fd -o -name OVMF_VARS.fd \) -print | sed -n '1p')
  fi
done
fetch_firmware() {
  firmware_url=$1
  firmware_sha=$2
  firmware_output=$3
  firmware_label=$4
  case "$firmware_url" in
    https://?*) ;;
    *)
      printf '%s\n' "bootstrap-legacy: $firmware_label firmware URL must use HTTPS" >&2
      exit 2
      ;;
  esac
  if [ "${#firmware_sha}" -ne 64 ]; then
    printf '%s\n' "bootstrap-legacy: $firmware_label firmware SHA256 must be 64 hexadecimal characters" >&2
    exit 2
  fi
  case "$firmware_sha" in
    ''|*[!0-9a-fA-F]*)
      printf '%s\n' "bootstrap-legacy: $firmware_label firmware SHA256 must contain only hexadecimal characters" >&2
      exit 2
      ;;
  esac
  curl -fsSL --retry 3 --connect-timeout 15 \
    --max-time "${DISTILL_DOWNLOAD_TIMEOUT:-600}" "$firmware_url" -o "$firmware_output"
  actual_firmware_sha=$(shasum -a 256 "$firmware_output" | awk '{print $1}')
  expected_firmware_sha=$(printf '%s' "$firmware_sha" | tr '[:upper:]' '[:lower:]')
  test "$actual_firmware_sha" = "$expected_firmware_sha" || {
    printf '%s\n' "bootstrap-legacy: $firmware_label firmware SHA256 mismatch" >&2
    exit 1
  }
}
