  guest_install_seconds=$(jq -r '.guest_install_seconds // empty' "$output_dir/unattended-install.json" || true)
  case "$guest_boot_seconds" in
    ''|*[!0-9]*) guest_boot_seconds=$(( $(date +%s) - guest_boot_started )) ;;
  esac
  record_timing_seconds guest_boot "$guest_boot_seconds"
  case "$guest_install_seconds" in
    ''|*[!0-9]*) ;;
    *) record_timing_seconds guest_install "$guest_install_seconds" ;;
  esac
else
  record_timing guest_boot "$guest_boot_started"
fi
test "$unattended_status" -eq 0

ssh_started=$(date +%s)
DISTILL_GUEST_SSH_CONNECT_TIMEOUT=5 \
  "$repo_dir/scripts/hvf/wait-ssh" "$target" "$port" \
  "${DISTILL_GUEST_SSH_TIMEOUT:-1200}"
record_timing guest_ssh_wait "$ssh_started"
guest_ssh() {
  "$guest_ssh_cmd" ssh "$target" "$port" "$@"
}
scp_guest() {
  "$guest_ssh_cmd" scp "$port" "$@"
}
scp_guest "$target:/var/tmp/brew-distill/ssh-ready.json" "$output_dir/ssh-ready.json"
guest_ssh cat /var/tmp/brew-distill/firstboot.log > "$output_dir/firstboot.log"
ssh_ready_fingerprint=$(jq -r '.public_key_fingerprint // empty' "$output_dir/ssh-ready.json")
test "$ssh_ready_fingerprint" = "$expected_ssh_fingerprint" || {
  printf '%s\n' "bootstrap-legacy: guest SSH public key fingerprint mismatch" >&2
  exit 1
}
guest_ssh_user=$(jq -r '.user // empty' "$output_dir/ssh-ready.json")
test "$guest_ssh_user" = "$guest_user" || {
  printf '%s\n' "bootstrap-legacy: guest SSH user mismatch" >&2
  exit 1
}
guest_ssh sudo -n true

brew_started=$(date +%s)
homebrew_installer=${DISTILL_HOMEBREW_INSTALLER:-}
if [ -n "$homebrew_installer" ]; then
  test -f "$homebrew_installer" || {
    printf '%s\n' "bootstrap-legacy: Homebrew installer does not exist: $homebrew_installer" >&2
    exit 1
  }
else
  homebrew_url=${DISTILL_HOMEBREW_INSTALLER_URL:-}
  homebrew_sha=${DISTILL_HOMEBREW_INSTALLER_SHA256:-}
  test -n "$homebrew_url" || {
    printf '%s\n' "bootstrap-legacy: provide DISTILL_HOMEBREW_INSTALLER or installer URL/SHA" >&2
    exit 1
  }
  case "$homebrew_url" in
    https://?*) ;;
    *)
      printf '%s\n' "bootstrap-legacy: Homebrew installer URL must use HTTPS" >&2
      exit 2
      ;;
  esac
  if [ "${#homebrew_sha}" -ne 64 ]; then
    printf '%s\n' "bootstrap-legacy: Homebrew installer SHA256 must be 64 hexadecimal characters" >&2
    exit 2
  fi
  case "$homebrew_sha" in
    ''|*[!0-9a-fA-F]*)
      printf '%s\n' "bootstrap-legacy: Homebrew installer SHA256 must contain only hexadecimal characters" >&2
      exit 2
      ;;
  esac
  homebrew_installer="$work_dir/homebrew-install.sh"
  curl -fsSL --retry 3 --connect-timeout 15 \
    --max-time "${DISTILL_DOWNLOAD_TIMEOUT:-600}" "$homebrew_url" \
    -o "$homebrew_installer"
  actual_homebrew_sha=$(shasum -a 256 "$homebrew_installer" | awk '{print $1}')
  expected_homebrew_sha=$(printf '%s' "$homebrew_sha" | tr '[:upper:]' '[:lower:]')
  test "$actual_homebrew_sha" = "$expected_homebrew_sha" || {
    printf '%s\n' "bootstrap-legacy: Homebrew installer SHA256 mismatch" >&2
    exit 1
  }
fi

scp_guest "$homebrew_installer" "$target:/var/tmp/brew-distill/homebrew-install.sh"
guest_ssh env HOMEBREW_NO_AUTO_UPDATE=1 NONINTERACTIVE=1 \
  /bin/bash /var/tmp/brew-distill/homebrew-install.sh \
  > "$output_dir/homebrew-install.log" 2>&1

scp_guest "$repo_dir/scripts/hvf/bootstrap-homebrew" \
  "$target:/var/tmp/brew-distill/bootstrap-homebrew"
guest_ssh env DISTILL_GUEST=1 \
  /bin/sh /var/tmp/brew-distill/bootstrap-homebrew /var/tmp/brew-distill/homebrew \
  > "$output_dir/homebrew-bootstrap.log" 2>&1
for file in brew-version.txt brew-config.txt brew-doctor.txt; do
  scp_guest "$target:/var/tmp/brew-distill/homebrew/$file" "$output_dir/$file"
done
record_timing brew_bootstrap "$brew_started"

guest_ssh sudo -n launchctl bootout system/org.brew-distill.firstboot >/dev/null 2>&1 || true
guest_ssh sudo -n rm -f \
  /Library/LaunchDaemons/org.brew-distill.firstboot.plist \
  /usr/local/libexec/brew-distill-firstboot \
  /usr/local/libexec/brew-distill-guest-key \
  /usr/local/libexec/brew-distill-provision-ssh \
  /var/tmp/brew-distill/firstboot.log \
  /var/tmp/brew-distill/homebrew-install.sh \
  /private/etc/sudoers.d/brew-distill \
  /var/db/brew-distill-bootstrap.done

recovery_sha=$(jq -r '.image_sha256 // empty' "$recovery_metadata")
media_sha=$(shasum -a 256 "$install_media" | awk '{print $1}')
homebrew_sha=$(shasum -a 256 "$homebrew_installer" | awk '{print $1}')
jq -n \
  --arg installer "$installer" \
  --arg recovery_sha "$recovery_sha" \
  --arg recovery "$recovery" \
  --arg media_sha "$media_sha" \
  --arg homebrew_sha "$homebrew_sha" \
  --arg target "$target" \
  --argjson disk_gib "$disk_gib" \
  '{schema:1,installer:$installer,recovery_image:$recovery,recovery_image_sha256:$recovery_sha,install_media_sha256:$media_sha,homebrew_installer_sha256:$homebrew_sha,target:$target,disk_gib:$disk_gib,qemu_runtime_config:".qemu-runtime.json",vm_image:false}' \
  > "$output_dir/legacy-bootstrap.json"
printf '%s\n' "Legacy guest bootstrap complete"
