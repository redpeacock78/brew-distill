#!/bin/sh
set -eu

export LC_ALL=C

if [ "$#" -ne 4 ]; then
  printf '%s\n' "usage: bootstrap-legacy INSTALLER.app BASE.qcow2 OPENCORE-DIR HVF-OUTPUT-DIR" >&2
  exit 2
fi

installer=$1
base=$2
opencore_dir=$3
output_dir=$4
repo_dir=$(cd -- "$(dirname -- "$0")/../.." && pwd)
major=${DISTILL_MACOS_MAJOR:-${DISTILL_MACOS:-}}
case "$major" in
  11|12|13|14) ;;
  *)
    printf '%s\n' "bootstrap-legacy: DISTILL_MACOS_MAJOR or DISTILL_MACOS must be 11, 12, 13, or 14" >&2
    exit 2
    ;;
esac
guest_user=${DISTILL_GUEST_SSH_USER:-distill}
target=${DISTILL_GUEST_SSH_TARGET:-$guest_user@127.0.0.1}
port=${DISTILL_GUEST_SSH_PORT:-2222}
guest_ssh_cmd="$repo_dir/scripts/hvf/guest-ssh"
unattended="$repo_dir/scripts/hvf/unattended-install"
fetch_recovery="$repo_dir/scripts/hvf/fetch-recovery"
public_key=${DISTILL_GUEST_SSH_PUBLIC_KEY_FILE:-}
ssh_identity=${DISTILL_GUEST_SSH_IDENTITY:-}
require_ssh_identity=${DISTILL_REQUIRE_GUEST_SSH_IDENTITY:-0}
qemu_args=${DISTILL_QEMU_ARGS_JSON:-}
qemu_code_url=${DISTILL_QEMU_CODE_URL:-}
qemu_code_sha=${DISTILL_QEMU_CODE_SHA256:-}
qemu_vars_url=${DISTILL_QEMU_VARS_URL:-}
qemu_vars_sha=${DISTILL_QEMU_VARS_SHA256:-}
qemu_bin=${QEMU_SYSTEM_X86_64:-qemu-system-x86_64}
qemu_img=${QEMU_IMG:-qemu-img}
plutil_cmd=${DISTILL_PLUTIL:-plutil}
disk_rotation_rate=${DISTILL_QEMU_DISK_ROTATION_RATE:-0}
disk_cache=${DISTILL_QEMU_DISK_CACHE:-writeback}
disk_device=${DISTILL_QEMU_DISK_DEVICE:-sata}
disk_profile=${DISTILL_QEMU_DISK_PROFILE:-current}
disk_format=${DISTILL_BASE_FORMAT:-qcow2}
install_package_mode=${DISTILL_LEGACY_INSTALLPACKAGE_MODE:-required}
cpu_profile=${DISTILL_QEMU_CPU_PROFILE:-current}
cpu_model=${DISTILL_QEMU_CPU_MODEL:-current}
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/brew-distill-legacy-bootstrap.XXXXXX")
qemu_pid=
install_media=
matching_recovery_mount=

mkdir -p "$output_dir"

case "$guest_user" in
  ''|*[!A-Za-z0-9._-]*)
    printf '%s\n' "bootstrap-legacy: invalid guest user: $guest_user" >&2
    exit 2
    ;;
esac
case "$require_ssh_identity" in
  0|1) ;;
  *)
    printf '%s\n' "bootstrap-legacy: DISTILL_REQUIRE_GUEST_SSH_IDENTITY must be 0 or 1" >&2
    exit 2
    ;;
esac
case "$disk_rotation_rate" in
  ''|*[!0-9]*)
    printf '%s\n' "bootstrap-legacy: DISTILL_QEMU_DISK_ROTATION_RATE must be a non-negative integer" >&2
    exit 2
    ;;
esac
case "$disk_cache" in
  writeback|unsafe) ;;
  *)
    printf '%s\n' "bootstrap-legacy: DISTILL_QEMU_DISK_CACHE must be writeback or unsafe" >&2
    exit 2
    ;;
esac
case "$disk_profile" in
  current|tuned|raw) ;;
  *)
    printf '%s\n' "bootstrap-legacy: DISTILL_QEMU_DISK_PROFILE must be current, tuned, or raw" >&2
    exit 2
    ;;
esac
if [ "$disk_profile" = raw ]; then
  disk_format=raw
fi
case "$disk_format" in
  qcow2|raw) ;;
  *)
    printf '%s\n' "bootstrap-legacy: base image format must be qcow2 or raw" >&2
    exit 2
    ;;
esac
case "$install_package_mode" in
  required|omit) ;;
  *)
    printf '%s\n' "bootstrap-legacy: DISTILL_LEGACY_INSTALLPACKAGE_MODE must be required or omit" >&2
    exit 2
    ;;
esac
cpu_smp=
case "$cpu_profile" in
  current) ;;
  4vcpu) cpu_smp='4,cores=4,sockets=1' ;;
  6vcpu) cpu_smp='6,cores=6,sockets=1' ;;
  *)
    printf '%s\n' "bootstrap-legacy: DISTILL_QEMU_CPU_PROFILE must be current, 4vcpu, or 6vcpu" >&2
    exit 2
    ;;
esac
case "$cpu_model" in
  current) ;;
  host)
    qemu_cpu_model=host
    ;;
  *)
    printf '%s\n' "bootstrap-legacy: DISTILL_QEMU_CPU_MODEL must be current or host" >&2
    exit 2
    ;;
esac
case "$disk_device" in
  sata|nvme) ;;
  *)
    printf '%s\n' "bootstrap-legacy: DISTILL_QEMU_DISK_DEVICE must be sata or nvme" >&2
    exit 2
    ;;
esac

cleanup() {
  status=$?
  if [ -n "$qemu_pid" ] && kill -0 "$qemu_pid" 2>/dev/null; then
    kill -TERM "$qemu_pid" 2>/dev/null || true
    wait "$qemu_pid" 2>/dev/null || true
  fi
  if [ -n "$install_media" ] && [ -f "$install_media" ]; then
    media_mount="$work_dir/install-media-diagnostics"
    attach_log="$output_dir/install-media-attach.log"
    mkdir -p "$media_mount"
    if hdiutil attach -readonly -nobrowse -mountpoint "$media_mount" "$install_media" >"$attach_log" 2>&1; then
      for media_file in diskutil-list.txt target-disk-info.txt target-volume-info.txt csrutil-status.txt nvram-diagnostics.txt startosinstall-environment.txt network-diagnostics.txt startosinstall-events.log startosinstall-watch.log install-script.log install-script.status startosinstall.log startosinstall-stderr.log install-system.log; do
        if [ -f "$media_mount/$media_file" ]; then
          cp "$media_mount/$media_file" "$output_dir/$media_file"
        fi
      done
      hdiutil detach "$media_mount" >>"$attach_log" 2>&1 || true
    else
      printf '%s\n' "install media diagnostics attach failed" >>"$attach_log"
    fi
  fi
  if [ -n "$matching_recovery_mount" ]; then
    if ! hdiutil detach "$matching_recovery_mount" >>"$output_dir/matching-recovery.log" 2>&1; then
      hdiutil detach -force "$matching_recovery_mount" >>"$output_dir/matching-recovery.log" 2>&1 || true
    fi
  fi
  rm -rf "$work_dir"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

if [ "$(uname -s)" != "Darwin" ]; then
  printf '%s\n' "bootstrap-legacy: host-side bootstrap requires macOS" >&2
  exit 1
fi
for path in "$installer" "$base" "$opencore_dir"; do
  test -e "$path" || {
    printf '%s\n' "bootstrap-legacy: required input is unavailable: $path" >&2
    exit 1
  }
done
test -d "$installer" || {
  printf '%s\n' "bootstrap-legacy: installer app is not a directory: $installer" >&2
  exit 1
}
test -x "$installer/Contents/Resources/startosinstall" || {
  printf '%s\n' "bootstrap-legacy: installer has no executable startosinstall" >&2
  exit 1
}
test -f "$public_key" || {
  printf '%s\n' "bootstrap-legacy: guest SSH public key is unavailable: $public_key" >&2
  exit 1
}
if [ -n "$ssh_identity" ]; then
  test -r "$ssh_identity" || {
    printf '%s\n' "bootstrap-legacy: guest SSH identity is unavailable: $ssh_identity" >&2
    exit 1
  }
elif [ "$require_ssh_identity" = "1" ]; then
  printf '%s\n' "bootstrap-legacy: guest SSH identity is required" >&2
  exit 1
fi
base=$(cd -- "$(dirname -- "$base")" && pwd)/$(basename -- "$base")
test -x "$guest_ssh_cmd" || {
  printf '%s\n' "bootstrap-legacy: guest SSH wrapper is unavailable: $guest_ssh_cmd" >&2
  exit 1
}
test -x "$unattended" || {
  printf '%s\n' "bootstrap-legacy: unattended installer is unavailable: $unattended" >&2
  exit 1
}
test -x "$fetch_recovery" || {
  printf '%s\n' "bootstrap-legacy: recovery downloader is unavailable: $fetch_recovery" >&2
  exit 1
}
test -n "$qemu_args" || {
  printf '%s\n' "bootstrap-legacy: DISTILL_QEMU_ARGS_JSON is required" >&2
  exit 1
}
if [ -n "$cpu_smp" ]; then
  qemu_args=$(printf '%s' "$qemu_args" | jq --arg smp "$cpu_smp" '
    reduce .[] as $arg ({args:[],skip:false,replaced:false};
      if .skip then .skip=false
      elif $arg == "-smp" then .args += ["-smp",$smp] | .skip=true | .replaced=true
      elif ($arg | startswith("-smp=")) then .args += ["-smp=" + $smp] | .replaced=true
      else .args += [$arg]
      end
    ) | if .replaced then .args else error("-smp option was not found") end
  ') || {
    printf '%s\n' "bootstrap-legacy: cannot apply QEMU CPU profile to DISTILL_QEMU_ARGS_JSON" >&2
    exit 2
  }
fi
if [ "$cpu_model" = host ]; then
  qemu_args=$(printf '%s' "$qemu_args" | jq --arg cpu "$qemu_cpu_model" '
    reduce .[] as $arg ({args:[],skip:false,replaced:false};
      if .skip then .skip=false
      elif $arg == "-cpu" then .args += ["-cpu",$cpu] | .skip=true | .replaced=true
      elif ($arg | startswith("-cpu=")) then .args += ["-cpu=" + $cpu] | .replaced=true
      else .args += [$arg]
      end
    ) | if .replaced then .args else error("-cpu option was not found") end
  ') || {
    printf '%s\n' "bootstrap-legacy: cannot apply QEMU CPU model to DISTILL_QEMU_ARGS_JSON" >&2
    exit 2
  }
fi
command -v "$plutil_cmd" >/dev/null 2>&1 || {
  printf '%s\n' "bootstrap-legacy: plutil is required" >&2
  exit 1
}
for tool in "$qemu_bin" "$qemu_img" brew curl ditto hdiutil jq openssl pkgbuild productbuild pkgutil python3 shasum ssh-keygen; do
  command -v "$tool" >/dev/null 2>&1 || {
    printf '%s\n' "bootstrap-legacy: required tool is unavailable: $tool" >&2
    exit 1
  }
done
installer_app_info="$output_dir/installer-app-info.txt"
{
  printf '%s\n' "installer=$installer"
  for path in \
    "$installer/Contents/Info.plist" \
    "$installer/Contents/Resources/startosinstall" \
    "$installer/Contents/SharedSupport/SharedSupport.dmg" \
    "$installer/Contents/SharedSupport/InstallInfo.plist" \
    "$installer/Contents/SharedSupport/BuildManifest.plist" \
    "$installer/Contents/SharedSupport/BaseSystem.dmg"; do
    if [ -e "$path" ]; then
      ls -ld "$path"
    else
      printf '%s\n' "MISSING $path"
    fi
  done
  printf '%s\n' 'bundle metadata'
  "$plutil_cmd" -extract CFBundleShortVersionString raw -o - "$installer/Contents/Info.plist" 2>&1 || true
  "$plutil_cmd" -extract CFBundleVersion raw -o - "$installer/Contents/Info.plist" 2>&1 || true
} > "$installer_app_info"
expected_ssh_fingerprint=$(ssh-keygen -lf "$public_key" 2>/dev/null | awk 'NR == 1 {print $2}')
test -n "$expected_ssh_fingerprint" || {
  printf '%s\n' "bootstrap-legacy: guest SSH public key is invalid" >&2
  exit 2
}
if [ -n "$ssh_identity" ]; then
  derived_public_key="$work_dir/derived-guest-key.pub"
  ssh-keygen -y -P '' -f "$ssh_identity" > "$derived_public_key" || {
    printf '%s\n' "bootstrap-legacy: SSH identity cannot derive a public key" >&2
    exit 2
  }
  derived_ssh_fingerprint=$(ssh-keygen -lf "$derived_public_key" 2>/dev/null | awk 'NR == 1 {print $2}')
  test "$derived_ssh_fingerprint" = "$expected_ssh_fingerprint" || {
    printf '%s\n' "bootstrap-legacy: SSH identity and public key do not match" >&2
    exit 2
  }
fi
mkdir -p "$output_dir"
jq -n \
  --arg user "$guest_user" \
  --arg fingerprint "$expected_ssh_fingerprint" \
  --argjson identity_configured "$([ -n "$ssh_identity" ] && printf 1 || printf 0)" \
  --argjson identity_required "$require_ssh_identity" \
  '{schema:1,user:$user,public_key_fingerprint:$fingerprint,identity_configured:($identity_configured == 1),identity_required:($identity_required == 1)}' \
  > "$output_dir/ssh-client.json"
timing_recorder="$repo_dir/scripts/hvf/record-timing"
timing_file=${DISTILL_PHASE_TIMINGS:-$output_dir/phase-timings.json}
record_timing() {
  timing_phase=$1
  timing_started=$2
  "$timing_recorder" "$timing_file" "$timing_phase" "$(( $(date +%s) - timing_started ))" || true
}
record_timing_seconds() {
  "$timing_recorder" "$timing_file" "$1" "$2" || true
}
printf '%s' "$qemu_args" | jq -e \
  'type == "array" and length > 0 and all(.[]; type == "string") and (any(.[]; . == "-accel=hvf") or ([range(0; length - 1) as $i | .[$i] == "-accel" and .[$i + 1] == "hvf"] | any))' >/dev/null || {
  printf '%s\n' "bootstrap-legacy: DISTILL_QEMU_ARGS_JSON must request -accel hvf" >&2
  exit 2
}

capabilities="$output_dir/installer-capabilities.json"
test -f "$capabilities" || {
  printf '%s\n' "bootstrap-legacy: installer capabilities are missing: $capabilities" >&2
  exit 1
}
capability() {
  [ "$($plutil_cmd -extract "options.$1" raw -o - "$capabilities" 2>/dev/null)" = "true" ]
}
capability agreetolicense || {
  printf '%s\n' "bootstrap-legacy: installer does not expose --agreetolicense" >&2
  exit 1
}
if [ "$install_package_mode" = required ]; then
  capability installpackage || {
    printf '%s\n' "bootstrap-legacy: installer does not expose --installpackage" >&2
    exit 1
  }
fi
nointeraction_arg=
if capability nointeraction; then
  nointeraction_arg=' --nointeraction'
fi
install_target_mode=${DISTILL_LEGACY_INSTALL_TARGET_MODE:-auto}
install_target_is_volume=0
case "$install_target_mode" in
  auto)
    # Ventura accepts --volume from Recovery even though startosinstall --usage omits it.
    if capability volume || [ "$major" = "13" ]; then
      install_target_args=' --volume /Volumes/MACOS'
      install_target_is_volume=1
    elif capability eraseinstall && capability newvolumename; then
      install_target_args=' --eraseinstall --newvolumename MACOS'
      install_target_is_volume=0
    else
      printf '%s\n' "bootstrap-legacy: installer exposes neither --volume nor --eraseinstall/--newvolumename" >&2
      exit 1
    fi
    ;;
  volume)
    if capability volume || [ "$major" = "13" ]; then
      install_target_args=' --volume /Volumes/MACOS'
      install_target_is_volume=1
    else
      printf '%s\n' "bootstrap-legacy: requested volume target mode is unavailable" >&2
      exit 1
    fi
    ;;
  eraseinstall)
    if ! capability eraseinstall || ! capability newvolumename; then
      printf '%s\n' "bootstrap-legacy: requested eraseinstall target mode is unavailable" >&2
      exit 1
    fi
    install_target_args=' --eraseinstall --newvolumename MACOS'
    install_target_is_volume=0
    ;;
  *)
    printf '%s\n' "bootstrap-legacy: DISTILL_LEGACY_INSTALL_TARGET_MODE must be auto, volume, or eraseinstall" >&2
    exit 2
    ;;
esac
rebootdelay_arg=
if capability rebootdelay; then
  rebootdelay_arg=' --rebootdelay 0'
fi
pidtosignal_arg=
pidtosignal_enabled=0
if capability pidtosignal; then
  pidtosignal_arg=' --pidtosignal $$'
  pidtosignal_enabled=1
fi

test -f "$opencore_dir/EFI/BOOT/BOOTx64.efi" || {
  printf '%s\n' "bootstrap-legacy: OpenCore BOOTx64.efi is missing" >&2
  exit 1
}
test -f "$opencore_dir/EFI/OC/OpenCore.efi" || {
  printf '%s\n' "bootstrap-legacy: OpenCore.efi is missing" >&2
  exit 1
}
test -f "$opencore_dir/EFI/OC/config.plist" || {
  printf '%s\n' "bootstrap-legacy: OpenCore config.plist is missing" >&2
  exit 1
}
"$plutil_cmd" -lint "$opencore_dir/EFI/OC/config.plist" >/dev/null || {
  printf '%s\n' "bootstrap-legacy: OpenCore config.plist is invalid" >&2
  exit 1
}
test -f "${DISTILL_OPENCORE_DISK:-}" || {
  printf '%s\n' "bootstrap-legacy: DISTILL_OPENCORE_DISK is required" >&2
  exit 1
}
opencore_disk=$DISTILL_OPENCORE_DISK
opencore_disk=$(cd -- "$(dirname -- "$opencore_disk")" && pwd)/$(basename -- "$opencore_disk")

virtual_size=$(
  "$qemu_img" info --output=json "$base" | jq -r '."virtual-size" // empty'
)
case "$virtual_size" in
  ''|*[!0-9]*)
    printf '%s\n' "bootstrap-legacy: cannot determine base image virtual size" >&2
    exit 1
    ;;
esac
disk_gib=$(( (virtual_size + 1073741823) / 1073741824 ))
test "$disk_gib" -gt 0 || {
  printf '%s\n' "bootstrap-legacy: base image virtual size is zero" >&2
  exit 1
}

guest_password=$(openssl rand -hex 24 2>/dev/null || true)
test -n "$guest_password" || {
  printf '%s\n' "bootstrap-legacy: openssl could not generate the temporary guest password" >&2
  exit 1
}

pkg_root="$work_dir/pkg-root"
install_media_started=$(date +%s)
mkdir -p "$pkg_root/usr/local/libexec" "$pkg_root/Library/LaunchDaemons"
cp "$public_key" "$pkg_root/usr/local/libexec/brew-distill-guest-key"
cp "$repo_dir/scripts/hvf/provision-ssh" "$pkg_root/usr/local/libexec/brew-distill-provision-ssh"
chmod 644 "$pkg_root/usr/local/libexec/brew-distill-guest-key"
chmod 755 "$pkg_root/usr/local/libexec/brew-distill-provision-ssh"
cat > "$pkg_root/usr/local/libexec/brew-distill-firstboot" <<EOF
#!/bin/sh
set -eu

marker=/var/db/brew-distill-bootstrap.done
user=$guest_user
password=$guest_password
key=/usr/local/libexec/brew-distill-guest-key
output=/var/tmp/brew-distill
sudoers=/private/etc/sudoers.d/brew-distill

/bin/mkdir -p "\$output"
exec >> "\$output/firstboot.log" 2>&1

if ! /usr/bin/id "\$user" >/dev/null 2>&1; then
  /usr/sbin/sysadminctl -addUser "\$user" -fullName "Distill Builder" -password "\$password" -admin
fi
/bin/mkdir -p /private/etc/sudoers.d
/bin/printf '%s\\n' "\$user ALL=(ALL) NOPASSWD: ALL" > "\$sudoers"
/bin/chmod 440 "\$sudoers"
/usr/sbin/visudo -cf "\$sudoers" >/dev/null
DISTILL_GUEST=1 \\
DISTILL_GUEST_SSH_USER="\$user" \\
DISTILL_GUEST_SSH_PUBLIC_KEY_FILE="\$key" \\
  /usr/local/libexec/brew-distill-provision-ssh "\$output"
/bin/touch "\$marker"
EOF
chmod 755 "$pkg_root/usr/local/libexec/brew-distill-firstboot"
cat > "$pkg_root/Library/LaunchDaemons/org.brew-distill.firstboot.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.brew-distill.firstboot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/brew-distill-firstboot</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/brew-distill-firstboot.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/brew-distill-firstboot.log</string>
</dict>
</plist>
PLIST

bootstrap_component_pkg="$work_dir/brew-distill-bootstrap-component.pkg"
bootstrap_pkg="$work_dir/brew-distill-bootstrap.pkg"
bootstrap_pkg_started=$(date +%s)
pkgbuild --root "$pkg_root" --identifier org.brew-distill.bootstrap \
  --version 1 --install-location / "$bootstrap_component_pkg" >/dev/null
distribution="$work_dir/Distribution"
productbuild --synthesize --package "$bootstrap_component_pkg" "$distribution"
productbuild --distribution "$distribution" --package-path "$work_dir" "$bootstrap_pkg" >/dev/null
record_timing bootstrap_pkg_build "$bootstrap_pkg_started"

package_info="$output_dir/startosinstall-package-info.txt"
package_expanded="$work_dir/bootstrap-product-expanded"
{
  printf '%s\n' "install_package_mode=$install_package_mode" "component_package=$bootstrap_component_pkg" "product_package=$bootstrap_pkg"
  printf '%s\n' '[component payload]'
  pkgutil --payload-files "$bootstrap_component_pkg" 2>&1 || true
  printf '%s\n' '[product payload]'
  pkgutil --payload-files "$bootstrap_pkg" 2>&1 || true
  printf '%s\n' '[product signature]'
  pkgutil --check-signature "$bootstrap_pkg" 2>&1 || true
  if pkgutil --expand "$bootstrap_pkg" "$package_expanded" >/dev/null 2>&1; then
    printf '%s\n' '[expanded product files]'
    find "$package_expanded" -maxdepth 3 -type f -print | sort
  fi
} > "$package_info"

installpackage_arg=
if [ "$install_package_mode" = required ]; then
  installpackage_arg=' --installpackage /Volumes/InstallMedia/brew-distill-bootstrap.pkg'
fi

media_root="$work_dir/install-media-root"
mkdir -p "$media_root"
installer_tree_started=$(date +%s)
installer_app_name=$(basename -- "$installer")
installer_app_path="$media_root/$installer_app_name"
ditto "$installer" "$installer_app_path"
record_timing installer_tree_copy "$installer_tree_started"
cp "$bootstrap_pkg" "$media_root/brew-distill-bootstrap.pkg"
install_script="$media_root/brew-distill-install"
cat > "$install_script" <<EOF
#!/bin/sh
set -eux

log=/Volumes/InstallMedia/install-script.log
exec >> "\$log" 2>&1

diskutil list > /Volumes/InstallMedia/diskutil-list.txt 2>&1
cat /Volumes/InstallMedia/diskutil-list.txt
d=\$(awk '
/^\/dev\/disk[0-9]+ / {
  physical=(\$0 ~ / \\(internal, physical\\):$/)
  disk=physical ? \$1 : ""
  if (physical) sub(/^\/dev\//, "", disk)
  next
}
physical && /^[[:space:]]*0:/ {
  size=\$0
  sub(/^.*\\*/, "", size)
  gsub(/,/, ".", size)
  split(size, fields, /[[:space:]]+/)
  value=fields[1] + 0
  if (fields[2] == "MB") value /= 1024
  if (fields[2] == "TB") value *= 1024
  if (value > largest) {
    largest=value
    target=disk
  }
}
END {
  if (target != "") print target
}
' < /Volumes/InstallMedia/diskutil-list.txt)
printf 'TARGET_DISK=%s\\n' "\$d"
test -n "\$d"
diskutil info "\$d" > /Volumes/InstallMedia/target-disk-info.txt 2>&1
cat /Volumes/InstallMedia/target-disk-info.txt
csrutil_status_file=/Volumes/InstallMedia/csrutil-status.txt
nvram_file=/Volumes/InstallMedia/nvram-diagnostics.txt
csrutil status > "\$csrutil_status_file" 2>&1 || true
nvram -p 2>&1 | grep -Ei 'csr-active-config|boot-args|opencore|efi' > "\$nvram_file" || true
install_events=/Volumes/InstallMedia/startosinstall-events.log
printf '%s\\n' "INSTALL_SCRIPT_STARTED \$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "\$install_events"
if [ "$install_target_is_volume" = "1" ] && grep -Fq 'NVRAM Protections: enabled' "\$csrutil_status_file"; then
  printf '%s\\n' "STARTOSINSTALL_PRECONDITION_FAILED \$(date -u +%Y-%m-%dT%H:%M:%SZ) reason=nvram-protections-enabled" >> "\$install_events"
  printf '%s\\n' 78 > /Volumes/InstallMedia/install-script.status
  /sbin/shutdown -h now >> /Volumes/InstallMedia/install-script.log 2>&1 || true
  exit 78
fi
diskutil eraseDisk APFS MACOS "\$d"
target_volume=/Volumes/MACOS
test -d "\$target_volume"
