  log stream --style compact --level debug \\
    --predicate 'process == "startosinstall" OR process == "installd"' \\
    > /Volumes/InstallMedia/install-system.log 2>&1 &
  install_system_log_pid=\$!
fi
stop_install_system_log() {
  if [ -n "\$install_system_log_pid" ]; then
    kill "\$install_system_log_pid" 2>/dev/null || true
    wait "\$install_system_log_pid" 2>/dev/null || true
    install_system_log_pid=
  fi
}
prepare_signal_handler() {
  printf '%s\\n' "STARTOSINSTALL_PREPARE_COMPLETE \$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "\$install_events"
  if [ "$pidtosignal_enabled" = "1" ] && [ -s "\$install_pid_file" ]; then
    startosinstall_child=\$(cat "\$install_pid_file")
    kill -USR1 "\$startosinstall_child" 2>/dev/null || true
  fi
}
trap prepare_signal_handler USR1
set +e
run_startosinstall() {
  "\$startosinstall" \\
    --agreetolicense$install_target_args$nointeraction_arg$rebootdelay_arg$pidtosignal_arg$installpackage_arg \\
    > /Volumes/InstallMedia/startosinstall.log 2> /Volumes/InstallMedia/startosinstall-stderr.log &
  startosinstall_child=\$!
  printf '%s\\n' "\$startosinstall_child" > "\$install_pid_file"
  wait "\$startosinstall_child"
  status=\$?
  stop_install_system_log
  rm -f "\$install_pid_file"
  if [ "\$status" -ne 0 ]; then
    printf '%s\\n' "STARTOSINSTALL_FAILED \$(date -u +%Y-%m-%dT%H:%M:%SZ) status=\$status" >> "\$install_events"
    printf '%s\\n' "\$status" > /Volumes/InstallMedia/install-script.status
    /sbin/shutdown -h now >> /Volumes/InstallMedia/install-script.log 2>&1 || true
  fi
  return "\$status"
}
run_startosinstall &
startosinstall_pid=\$!
process_tree() {
  ps -axo pid=,ppid=,stat=,etime=,%cpu=,%mem=,command= 2>&1 | awk -v root="\$startosinstall_pid" '
    NF >= 2 {
      pid[\$1]=\$1
      parent[\$1]=\$2
      line[\$1]=\$0
    }
    END {
      for (candidate in pid) {
        ancestor=candidate
        while (ancestor != "" && ancestor != "0") {
          if (ancestor == root) {
            print line[candidate]
            break
          }
          ancestor=parent[ancestor]
        }
      }
    }
  ' || true
}
while kill -0 "\$startosinstall_pid" 2>/dev/null; do
  {
    printf '%s\\n' "PROCESS \$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    ps -p "\$startosinstall_pid" -o pid=,ppid=,stat=,etime=,%cpu=,%mem=,command= 2>&1 || true
    printf '%s\\n' 'PROCESS_TREE'
    process_tree
    df -h "\$target_volume" /Volumes/InstallMedia 2>&1 || true
    diskutil info "\$target_volume" 2>&1 || true
  } >> /Volumes/InstallMedia/startosinstall-watch.log 2>&1
  sleep 30
done
wait "\$startosinstall_pid"
status=\$?
set -e
printf '%s\\n' "STARTOSINSTALL_STATUS=\$status"
printf '%s\\n' "\$status" > /Volumes/InstallMedia/install-script.status
exit "\$status"
EOF
