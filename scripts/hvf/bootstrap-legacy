#!/bin/sh
set -eu

export LC_ALL=C

if [ "$#" -ne 4 ]; then
  printf '%s\n' "usage: bootstrap-legacy INSTALLER.app BASE.qcow2 OPENCORE-DIR HVF-OUTPUT-DIR" >&2
  exit 2
fi

installer=$1
base=$2
opencore_dir=$3
output_dir=$4
repo_dir=$(cd -- "$(dirname -- "$0")/../.." && pwd)
guest_user=${DISTILL_GUEST_SSH_USER:-distill}
target=${DISTILL_GUEST_SSH_TARGET:-$guest_user@127.0.0.1}
port=${DISTILL_GUEST_SSH_PORT:-2222}
guest_ssh_cmd="$repo_dir/scripts/hvf/guest-ssh"
unattended="$repo_dir/scripts/hvf/unattended-install"
public_key=${DISTILL_GUEST_SSH_PUBLIC_KEY_FILE:-}
qemu_args=${DISTILL_QEMU_ARGS_JSON:-}
qemu_code_url=${DISTILL_QEMU_CODE_URL:-}
qemu_code_sha=${DISTILL_QEMU_CODE_SHA256:-}
qemu_vars_url=${DISTILL_QEMU_VARS_URL:-}
qemu_vars_sha=${DISTILL_QEMU_VARS_SHA256:-}
qemu_bin=${QEMU_SYSTEM_X86_64:-qemu-system-x86_64}
qemu_img=${QEMU_IMG:-qemu-img}
plutil_cmd=${DISTILL_PLUTIL:-plutil}
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/brew-distill-legacy-bootstrap.XXXXXX")
qemu_pid=
install_media=

mkdir -p "$output_dir"

case "$guest_user" in
  ''|*[!A-Za-z0-9._-]*)
    printf '%s\n' "bootstrap-legacy: invalid guest user: $guest_user" >&2
    exit 2
    ;;
esac

cleanup() {
  status=$?
  if [ -n "$qemu_pid" ] && kill -0 "$qemu_pid" 2>/dev/null; then
    kill -TERM "$qemu_pid" 2>/dev/null || true
    wait "$qemu_pid" 2>/dev/null || true
  fi
  if [ -n "$install_media" ] && [ -f "$install_media" ]; then
    media_mount="$work_dir/install-media-diagnostics"
    mkdir -p "$media_mount"
    if hdiutil attach -readonly -nobrowse -mountpoint "$media_mount" "$install_media" >/dev/null 2>&1; then
      for media_file in diskutil-list.txt install-script.log install-script.status startosinstall.log; do
        if [ -f "$media_mount/$media_file" ]; then
          cp "$media_mount/$media_file" "$output_dir/$media_file"
        fi
      done
      hdiutil detach "$media_mount" >/dev/null 2>&1 || true
    fi
  fi
  rm -rf "$work_dir"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

if [ "$(uname -s)" != "Darwin" ]; then
  printf '%s\n' "bootstrap-legacy: host-side bootstrap requires macOS" >&2
  exit 1
fi
for path in "$installer" "$base" "$opencore_dir" "$public_key"; do
  test -e "$path" || {
    printf '%s\n' "bootstrap-legacy: required input is unavailable: $path" >&2
    exit 1
  }
done
base=$(cd -- "$(dirname -- "$base")" && pwd)/$(basename -- "$base")
test -x "$guest_ssh_cmd" || {
  printf '%s\n' "bootstrap-legacy: guest SSH wrapper is unavailable: $guest_ssh_cmd" >&2
  exit 1
}
test -x "$unattended" || {
  printf '%s\n' "bootstrap-legacy: unattended installer is unavailable: $unattended" >&2
  exit 1
}
test -n "$qemu_args" || {
  printf '%s\n' "bootstrap-legacy: DISTILL_QEMU_ARGS_JSON is required" >&2
  exit 1
}
command -v "$plutil_cmd" >/dev/null 2>&1 || {
  printf '%s\n' "bootstrap-legacy: plutil is required" >&2
  exit 1
}
for tool in "$qemu_bin" "$qemu_img" brew curl hdiutil jq openssl pkgbuild productbuild pkgutil shasum; do
  command -v "$tool" >/dev/null 2>&1 || {
    printf '%s\n' "bootstrap-legacy: required tool is unavailable: $tool" >&2
    exit 1
  }
done
mkdir -p "$output_dir"
timing_recorder="$repo_dir/scripts/hvf/record-timing"
timing_file=${DISTILL_PHASE_TIMINGS:-$output_dir/phase-timings.json}
record_timing() {
  timing_phase=$1
  timing_started=$2
  "$timing_recorder" "$timing_file" "$timing_phase" "$(( $(date +%s) - timing_started ))" || true
}
record_timing_seconds() {
  "$timing_recorder" "$timing_file" "$1" "$2" || true
}
printf '%s' "$qemu_args" | jq -e \
  'type == "array" and length > 0 and all(.[]; type == "string") and (any(.[]; . == "-accel=hvf") or ([range(0; length - 1) as $i | .[$i] == "-accel" and .[$i + 1] == "hvf"] | any))' >/dev/null || {
  printf '%s\n' "bootstrap-legacy: DISTILL_QEMU_ARGS_JSON must request -accel hvf" >&2
  exit 2
}

capabilities="$output_dir/installer-capabilities.json"
test -f "$capabilities" || {
  printf '%s\n' "bootstrap-legacy: installer capabilities are missing: $capabilities" >&2
  exit 1
}
capability() {
  [ "$($plutil_cmd -extract "options.$1" raw -o - "$capabilities" 2>/dev/null)" = "true" ]
}
for option in agreetolicense installpackage; do
  capability "$option" || {
    printf '%s\n' "bootstrap-legacy: installer does not expose --$option" >&2
    exit 1
  }
done
if capability volume; then
  install_target_args=' --volume /Volumes/MACOS'
elif capability eraseinstall && capability newvolumename; then
  install_target_args=' --eraseinstall --newvolumename MACOS'
else
  printf '%s\n' "bootstrap-legacy: installer exposes neither --volume nor --eraseinstall/--newvolumename" >&2
  exit 1
fi
nointeraction_arg=
if capability nointeraction; then
  nointeraction_arg=' --nointeraction'
fi
rebootdelay_arg=
if capability rebootdelay; then
  rebootdelay_arg=' --rebootdelay 0'
fi

base_system="$installer/Contents/SharedSupport/BaseSystem.dmg"
if [ ! -f "$base_system" ]; then
  base_system="$installer/Contents/SharedSupport/SharedSupport.dmg"
fi
test -f "$base_system" || {
  printf '%s\n' "bootstrap-legacy: installer has no boot image: $installer/Contents/SharedSupport/{BaseSystem.dmg,SharedSupport.dmg}" >&2
  exit 1
}
test -f "$opencore_dir/EFI/BOOT/BOOTx64.efi" || {
  printf '%s\n' "bootstrap-legacy: OpenCore BOOTx64.efi is missing" >&2
  exit 1
}
test -f "$opencore_dir/EFI/OC/OpenCore.efi" || {
  printf '%s\n' "bootstrap-legacy: OpenCore.efi is missing" >&2
  exit 1
}
test -f "${DISTILL_OPENCORE_DISK:-}" || {
  printf '%s\n' "bootstrap-legacy: DISTILL_OPENCORE_DISK is required" >&2
  exit 1
}
opencore_disk=$DISTILL_OPENCORE_DISK
opencore_disk=$(cd -- "$(dirname -- "$opencore_disk")" && pwd)/$(basename -- "$opencore_disk")

virtual_size=$(
  "$qemu_img" info --output=json "$base" | jq -r '."virtual-size" // empty'
)
case "$virtual_size" in
  ''|*[!0-9]*)
    printf '%s\n' "bootstrap-legacy: cannot determine base image virtual size" >&2
    exit 1
    ;;
esac
disk_gib=$(( (virtual_size + 1073741823) / 1073741824 ))
test "$disk_gib" -gt 0 || {
  printf '%s\n' "bootstrap-legacy: base image virtual size is zero" >&2
  exit 1
}

guest_password=$(openssl rand -hex 24 2>/dev/null || true)
test -n "$guest_password" || {
  printf '%s\n' "bootstrap-legacy: openssl could not generate the temporary guest password" >&2
  exit 1
}

pkg_root="$work_dir/pkg-root"
install_media_started=$(date +%s)
mkdir -p "$pkg_root/usr/local/libexec" "$pkg_root/Library/LaunchDaemons"
cp "$public_key" "$pkg_root/usr/local/libexec/brew-distill-guest-key"
cp "$repo_dir/scripts/hvf/provision-ssh" "$pkg_root/usr/local/libexec/brew-distill-provision-ssh"
chmod 644 "$pkg_root/usr/local/libexec/brew-distill-guest-key"
chmod 755 "$pkg_root/usr/local/libexec/brew-distill-provision-ssh"
cat > "$pkg_root/usr/local/libexec/brew-distill-firstboot" <<EOF
#!/bin/sh
set -eu

marker=/var/db/brew-distill-bootstrap.done
user=$guest_user
password=$guest_password
key=/usr/local/libexec/brew-distill-guest-key
output=/var/tmp/brew-distill
sudoers=/private/etc/sudoers.d/brew-distill

if ! /usr/bin/id "\$user" >/dev/null 2>&1; then
  /usr/sbin/sysadminctl -addUser "\$user" -fullName "Distill Builder" -password "\$password" -admin
fi
/bin/mkdir -p /private/etc/sudoers.d
/bin/printf '%s\\n' "\$user ALL=(ALL) NOPASSWD: ALL" > "\$sudoers"
/bin/chmod 440 "\$sudoers"
/usr/sbin/visudo -cf "\$sudoers" >/dev/null
DISTILL_GUEST=1 \\
DISTILL_GUEST_SSH_USER="\$user" \\
DISTILL_GUEST_SSH_PUBLIC_KEY_FILE="\$key" \\
  /usr/local/libexec/brew-distill-provision-ssh "\$output"
/bin/touch "\$marker"
EOF
chmod 755 "$pkg_root/usr/local/libexec/brew-distill-firstboot"
cat > "$pkg_root/Library/LaunchDaemons/org.brew-distill.firstboot.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.brew-distill.firstboot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/brew-distill-firstboot</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/brew-distill-firstboot.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/brew-distill-firstboot.log</string>
</dict>
</plist>
PLIST

bootstrap_component_pkg="$work_dir/brew-distill-bootstrap-component.pkg"
bootstrap_pkg="$work_dir/brew-distill-bootstrap.pkg"
bootstrap_pkg_started=$(date +%s)
pkgbuild --root "$pkg_root" --identifier org.brew-distill.bootstrap \
  --version 1 --install-location / "$bootstrap_component_pkg" >/dev/null
distribution="$work_dir/Distribution"
productbuild --synthesize --package "$bootstrap_component_pkg" "$distribution"
productbuild --distribution "$distribution" --package-path "$work_dir" "$bootstrap_pkg" >/dev/null
record_timing bootstrap_pkg_build "$bootstrap_pkg_started"

package_info="$output_dir/startosinstall-package-info.txt"
package_expanded="$work_dir/bootstrap-product-expanded"
{
  printf '%s\n' "component_package=$bootstrap_component_pkg" "product_package=$bootstrap_pkg"
  printf '%s\n' '[component payload]'
  pkgutil --payload-files "$bootstrap_component_pkg" 2>&1 || true
  printf '%s\n' '[product payload]'
  pkgutil --payload-files "$bootstrap_pkg" 2>&1 || true
  printf '%s\n' '[product signature]'
  pkgutil --check-signature "$bootstrap_pkg" 2>&1 || true
  if pkgutil --expand "$bootstrap_pkg" "$package_expanded" >/dev/null 2>&1; then
    printf '%s\n' '[expanded product files]'
    find "$package_expanded" -maxdepth 3 -type f -print | sort
  fi
} > "$package_info"

media_root="$work_dir/install-media-root"
mkdir -p "$media_root"
installer_tree_started=$(date +%s)
cp -R "$installer"/. "$media_root/"
record_timing installer_tree_copy "$installer_tree_started"
cp "$bootstrap_pkg" "$media_root/brew-distill-bootstrap.pkg"
install_script="$media_root/brew-distill-install"
cat > "$install_script" <<EOF
#!/bin/sh
set -eux

log=/Volumes/InstallMedia/install-script.log
exec >> "\$log" 2>&1

diskutil list > /Volumes/InstallMedia/diskutil-list.txt 2>&1
cat /Volumes/InstallMedia/diskutil-list.txt
d=\$(diskutil list | awk '
/GUID_partition_scheme/ {
  size=\$3
  sub(/^\\*/, "", size)
  gsub(/,/, ".", size)
  if ((size + 0) > largest) {
    largest=size + 0
    disk=\$NF
  }
}
END {
  if (disk != "") print disk
')
printf 'TARGET_DISK=%s\\n' "\$d"
test -n "\$d"
diskutil eraseDisk APFS MACOS "\$d"
printf '%s\\n' "STARTOSINSTALL_BEGIN \$(date -u +%Y-%m-%dT%H:%M:%SZ)"
set +e
/Volumes/InstallMedia/Contents/Resources/startosinstall \\
  --agreetolicense$install_target_args$nointeraction_arg$rebootdelay_arg \\
  --installpackage /Volumes/InstallMedia/brew-distill-bootstrap.pkg \\
  > /Volumes/InstallMedia/startosinstall.log 2>&1
status=\$?
set -e
printf '%s\\n' "STARTOSINSTALL_STATUS=\$status"
printf '%s\\n' "\$status" > /Volumes/InstallMedia/install-script.status
exit "\$status"
EOF
chmod 755 "$install_script"
command_file="$output_dir/startosinstall-command.txt"
cp "$install_script" "$command_file"
chmod 644 "$command_file"
install_media="$work_dir/install-media.dmg"
install_media_dmg_started=$(date +%s)
hdiutil create -srcfolder "$media_root" -format UDRW -volname InstallMedia \
  -ov "$install_media" >/dev/null
record_timing install_media_dmg_create "$install_media_dmg_started"

recovery_output="$work_dir/recovery"
recovery_dmg_started=$(date +%s)
hdiutil convert "$base_system" -format UDRW -o "$recovery_output" >/dev/null
record_timing recovery_dmg_convert "$recovery_dmg_started"
recovery="$recovery_output"
if [ ! -f "$recovery" ] && [ -f "$recovery.dmg" ]; then
  recovery="$recovery.dmg"
fi
test -s "$recovery" || {
  printf '%s\n' "bootstrap-legacy: hdiutil did not create recovery image" >&2
  exit 1
}

monitor="$work_dir/qemu-monitor.sock"
qemu_code=
qemu_vars=
firmware_started=$(date +%s)
qemu_prefix=$(brew --prefix qemu 2>/dev/null || true)
for firmware_dir in \
  "${DISTILL_QEMU_FIRMWARE_DIR:-}" \
  "$qemu_prefix/share/qemu" "$qemu_prefix/share" \
  /usr/local/share/qemu /opt/homebrew/share/qemu; do
  if [ -z "$firmware_dir" ] || [ ! -d "$firmware_dir" ]; then
    continue
  fi
  if [ -z "$qemu_code" ]; then
    qemu_code=$(find "$firmware_dir" -type f \( -name edk2-x86_64-code.fd -o -name OVMF_CODE.fd \) -print | sed -n '1p')
  fi
  if [ -z "$qemu_vars" ]; then
    qemu_vars=$(find "$firmware_dir" -type f \( -name edk2-x86_64-vars.fd -o -name edk2-i386-vars.fd -o -name OVMF_VARS.fd \) -print | sed -n '1p')
  fi
done
fetch_firmware() {
  firmware_url=$1
  firmware_sha=$2
  firmware_output=$3
  firmware_label=$4
  case "$firmware_url" in
    https://?*) ;;
    *)
      printf '%s\n' "bootstrap-legacy: $firmware_label firmware URL must use HTTPS" >&2
      exit 2
      ;;
  esac
  if [ "${#firmware_sha}" -ne 64 ]; then
    printf '%s\n' "bootstrap-legacy: $firmware_label firmware SHA256 must be 64 hexadecimal characters" >&2
    exit 2
  fi
  case "$firmware_sha" in
    ''|*[!0-9a-fA-F]*)
      printf '%s\n' "bootstrap-legacy: $firmware_label firmware SHA256 must contain only hexadecimal characters" >&2
      exit 2
      ;;
  esac
  curl -fsSL --retry 3 --connect-timeout 15 \
    --max-time "${DISTILL_DOWNLOAD_TIMEOUT:-600}" "$firmware_url" -o "$firmware_output"
  actual_firmware_sha=$(shasum -a 256 "$firmware_output" | awk '{print $1}')
  expected_firmware_sha=$(printf '%s' "$firmware_sha" | tr '[:upper:]' '[:lower:]')
  test "$actual_firmware_sha" = "$expected_firmware_sha" || {
    printf '%s\n' "bootstrap-legacy: $firmware_label firmware SHA256 mismatch" >&2
    exit 1
  }
}
if printf '%s' "$qemu_args" | jq -e 'any(.[]; contains("{{QEMU_CODE}}"))' >/dev/null && [ -n "$qemu_code_url" ]; then
  qemu_code="$work_dir/qemu-code.fd"
  fetch_firmware "$qemu_code_url" "$qemu_code_sha" "$qemu_code" code
fi
if printf '%s' "$qemu_args" | jq -e 'any(.[]; contains("{{QEMU_VARS}}"))' >/dev/null && [ -n "$qemu_vars_url" ]; then
  qemu_vars="$work_dir/qemu-vars.fd"
  fetch_firmware "$qemu_vars_url" "$qemu_vars_sha" "$qemu_vars" vars
fi
if printf '%s' "$qemu_args" | jq -e 'any(.[]; contains("{{QEMU_CODE}}"))' >/dev/null; then
  test -n "$qemu_code" || {
    printf '%s\n' "bootstrap-legacy: QEMU code firmware was not found" >&2
    exit 1
  }
fi
if [ -n "$qemu_code" ]; then
  code_copy="$output_dir/.qemu-code.fd"
  cp "$qemu_code" "$code_copy"
  qemu_code="$code_copy"
fi
if printf '%s' "$qemu_args" | jq -e 'any(.[]; contains("{{QEMU_VARS}}"))' >/dev/null; then
  test -n "$qemu_vars" || {
    printf '%s\n' "bootstrap-legacy: QEMU vars firmware was not found" >&2
    exit 1
  }
  vars_copy="$output_dir/.qemu-vars.fd"
  cp "$qemu_vars" "$vars_copy"
  qemu_vars="$vars_copy"
fi
record_timing firmware_prepare "$firmware_started"

runtime_args_json=$(
  printf '%s' "$qemu_args" | jq \
    --arg code "$qemu_code" \
    --arg vars "$qemu_vars" \
    '
     def managed:
       contains("{{RECOVERY}}") or
       contains("{{INSTALL_MEDIA}}") or
       contains("{{QEMU_MONITOR}}") or
       contains("RecoveryImage") or
       contains("RecoveryDevice") or
       contains("InstallMedia") or
       contains("InstallMediaDevice");
     map(
       gsub("\\{\\{QEMU_CODE\\}\\}"; $code) |
       gsub("\\{\\{QEMU_VARS\\}\\}"; $vars)
     ) as $args
     | [
         range(0; ($args | length)) as $i
         | select(
             (($args[$i] | managed) | not) and
             (($i + 1 >= ($args | length)) or (($args[$i + 1] | managed) | not))
           )
         | $args[$i]
       ]'
)
printf '%s' "$runtime_args_json" | jq -e \
  'map(gsub("\\{\\{DISK\\}\\}|\\{\\{OPENCORE\\}\\}|\\{\\{SERIAL_LOG\\}\\}"; "")) | all(.[]; contains("{{") | not)' >/dev/null || {
  printf '%s\n' "bootstrap-legacy: QEMU args contain an unsupported install-time placeholder" >&2
  exit 2
}
jq -n --argjson qemu_args "$runtime_args_json" \
  '{schema:1,qemu_args:$qemu_args,vm_image:false}' > "$output_dir/.qemu-runtime.json"
record_timing install_media_prepare "$install_media_started"

args_json=$(
  printf '%s' "$qemu_args" | jq \
    --arg disk "$base" \
    --arg opencore "$opencore_disk" \
    --arg recovery "$recovery" \
    --arg media "$install_media" \
    --arg monitor "$monitor" \
    --arg code "$qemu_code" \
    --arg vars "$qemu_vars" \
    'map(
       gsub("\\{\\{DISK\\}\\}"; $disk) |
       gsub("\\{\\{OPENCORE\\}\\}"; $opencore) |
       gsub("\\{\\{RECOVERY\\}\\}"; $recovery) |
       gsub("\\{\\{INSTALL_MEDIA\\}\\}"; $media) |
       gsub("\\{\\{QEMU_MONITOR\\}\\}"; $monitor) |
       gsub("\\{\\{QEMU_CODE\\}\\}"; $code) |
       gsub("\\{\\{QEMU_VARS\\}\\}"; $vars)
     ) as $args
     | if any($args[]; contains($opencore)) then $args else $args + [
         "-drive", ("id=OpenCoreBoot,if=none,format=raw,file=" + $opencore),
         "-device", "ide-hd,id=OpenCoreDevice,bus=sata.2,drive=OpenCoreBoot"
       ] end
     | if any(.[]; contains($recovery)) then . else . + [
         "-drive", ("id=RecoveryImage,if=none,format=raw,file=" + $recovery),
         "-device", "ide-hd,id=RecoveryDevice,bus=sata.3,drive=RecoveryImage"
       ] end
     | if any(.[]; contains($media)) then . else . + [
         "-drive", ("id=InstallMedia,if=none,format=raw,file=" + $media),
         "-device", "ide-hd,id=InstallMediaDevice,bus=sata.4,drive=InstallMedia"
       ] end
     | if any(.[]; contains($disk)) then . else . + [
         "-drive", ("id=MacHDD,if=none,format=qcow2,file=" + $disk),
         "-device", "ide-hd,id=MacHDDDevice,bus=sata.5,drive=MacHDD"
       ] end
     | if any(.[]; . == "-monitor" or startswith("-monitor=")) then . else . + [
         "-monitor", ("unix:" + $monitor + ",server=on,wait=off")
       ] end'
)

guest_boot_started=$(date +%s)
DISTILL_QEMU_ARGS_JSON="$args_json" \
  DISTILL_OPENCORE_DISK="$opencore_disk" \
  "$repo_dir/scripts/hvf/boot-guest" "$base" "$output_dir" \
  > "$output_dir/qemu.log" 2>&1 &
qemu_pid=$!

unattended_started=$(date +%s)
set +e
DISTILL_UNATTENDED_CAPTURE_DIR="$output_dir" \
DISTILL_UNATTENDED_FRAME_LOG="$output_dir/unattended-frames.jsonl" \
  "$unattended" --monitor "$monitor" --disk-gib "$disk_gib" \
  --command-file "$command_file" --output "$output_dir/unattended-install.json" \
  --frame "$work_dir/frame.ppm" \
  > "$output_dir/unattended-install.log" 2>&1
unattended_status=$?
set -e
if [ -s "$output_dir/unattended-install.json" ]; then
  guest_boot_seconds=$(jq -r '.guest_boot_seconds // empty' "$output_dir/unattended-install.json" || true)
  guest_install_seconds=$(jq -r '.guest_install_seconds // .elapsed_seconds // empty' "$output_dir/unattended-install.json" || true)
  case "$guest_boot_seconds" in
    ''|*[!0-9]*) guest_boot_seconds=$(( $(date +%s) - guest_boot_started )) ;;
  esac
  case "$guest_install_seconds" in
    ''|*[!0-9]*) guest_install_seconds=$(( $(date +%s) - unattended_started )) ;;
  esac
  record_timing_seconds guest_boot "$guest_boot_seconds"
  record_timing_seconds guest_install "$guest_install_seconds"
else
  record_timing guest_boot "$guest_boot_started"
  record_timing guest_install "$unattended_started"
fi
test "$unattended_status" -eq 0

ssh_started=$(date +%s)
DISTILL_GUEST_SSH_CONNECT_TIMEOUT=5 \
  "$repo_dir/scripts/hvf/wait-ssh" "$target" "$port" \
  "${DISTILL_GUEST_SSH_TIMEOUT:-1200}"
record_timing guest_ssh_wait "$ssh_started"
guest_ssh() {
  "$guest_ssh_cmd" ssh "$target" "$port" "$@"
}
scp_guest() {
  "$guest_ssh_cmd" scp "$port" "$@"
}
scp_guest "$target:/var/tmp/brew-distill/ssh-ready.json" "$output_dir/ssh-ready.json"
guest_ssh sudo -n true

brew_started=$(date +%s)
homebrew_installer=${DISTILL_HOMEBREW_INSTALLER:-}
if [ -n "$homebrew_installer" ]; then
  test -f "$homebrew_installer" || {
    printf '%s\n' "bootstrap-legacy: Homebrew installer does not exist: $homebrew_installer" >&2
    exit 1
  }
else
  homebrew_url=${DISTILL_HOMEBREW_INSTALLER_URL:-}
  homebrew_sha=${DISTILL_HOMEBREW_INSTALLER_SHA256:-}
  test -n "$homebrew_url" || {
    printf '%s\n' "bootstrap-legacy: provide DISTILL_HOMEBREW_INSTALLER or installer URL/SHA" >&2
    exit 1
  }
  case "$homebrew_url" in
    https://?*) ;;
    *)
      printf '%s\n' "bootstrap-legacy: Homebrew installer URL must use HTTPS" >&2
      exit 2
      ;;
  esac
  if [ "${#homebrew_sha}" -ne 64 ]; then
    printf '%s\n' "bootstrap-legacy: Homebrew installer SHA256 must be 64 hexadecimal characters" >&2
    exit 2
  fi
  case "$homebrew_sha" in
    ''|*[!0-9a-fA-F]*)
      printf '%s\n' "bootstrap-legacy: Homebrew installer SHA256 must contain only hexadecimal characters" >&2
      exit 2
      ;;
  esac
  homebrew_installer="$work_dir/homebrew-install.sh"
  curl -fsSL --retry 3 --connect-timeout 15 \
    --max-time "${DISTILL_DOWNLOAD_TIMEOUT:-600}" "$homebrew_url" \
    -o "$homebrew_installer"
  actual_homebrew_sha=$(shasum -a 256 "$homebrew_installer" | awk '{print $1}')
  expected_homebrew_sha=$(printf '%s' "$homebrew_sha" | tr '[:upper:]' '[:lower:]')
  test "$actual_homebrew_sha" = "$expected_homebrew_sha" || {
    printf '%s\n' "bootstrap-legacy: Homebrew installer SHA256 mismatch" >&2
    exit 1
  }
fi

scp_guest "$homebrew_installer" "$target:/var/tmp/brew-distill/homebrew-install.sh"
guest_ssh env HOMEBREW_NO_AUTO_UPDATE=1 NONINTERACTIVE=1 \
