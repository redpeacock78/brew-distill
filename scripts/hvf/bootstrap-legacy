if [ "${DISTILL_LEGACY_MATCHING_RECOVERY:-0}" = "1" ] && [ -f "$installer/Contents/SharedSupport/SharedSupport.dmg" ]; then
  matching_recovery_mount="$work_dir/matching-recovery"
  mkdir -p "$matching_recovery_mount"
  if hdiutil attach -readonly -nobrowse -mountpoint "$matching_recovery_mount" \
    "$installer/Contents/SharedSupport/SharedSupport.dmg" >> "$matching_recovery_log" 2>&1; then
    matching_recovery_file=$(find "$matching_recovery_mount" -type f \
      -path '*/AssetData/Restore/BaseSystem.dmg' -print | sed -n '1p')
    matching_recovery_zip=$(find "$matching_recovery_mount/com_apple_MobileAsset_MacSoftwareUpdate" \
      -maxdepth 1 -type f -name '*.zip' -print 2>/dev/null | sed -n '1p')
    if [ -z "$matching_recovery_zip" ]; then
      matching_recovery_zip=$(find "$matching_recovery_mount" -type f -name '*.zip' -print 2>/dev/null | sed -n '1p')
    fi
    printf '%s\n' "SharedSupport BaseSystem=$matching_recovery_file" \
      "SharedSupport asset zip=$matching_recovery_zip" >> "$matching_recovery_log"
    if [ -n "$matching_recovery_file" ] && cp "$matching_recovery_file" "$matching_recovery_source"; then
      matching_recovery_ready=1
      printf '%s\n' "matching Recovery copied from $matching_recovery_file" >> "$matching_recovery_log"
    elif [ -n "$matching_recovery_zip" ]; then
      matching_recovery_entry=$(unzip -Z1 "$matching_recovery_zip" 2>> "$matching_recovery_log" | \
        awk '
          {
            sub(/\r$/, "")
            path=tolower($0)
            if (path ~ /(^|\/)assetdata\/restore\/basesystem\.dmg$/ && restore == "") restore=$0
          }
          END {
            if (restore != "") print restore
          }
        ' || true)
      printf '%s\n' "SharedSupport Recovery entry=$matching_recovery_entry" >> "$matching_recovery_log"
      if [ -n "$matching_recovery_entry" ] && \
        unzip -p "$matching_recovery_zip" "$matching_recovery_entry" > "$matching_recovery_source" 2>> "$matching_recovery_log" && \
        [ -s "$matching_recovery_source" ]; then
        matching_recovery_ready=1
        printf '%s\n' "matching Recovery extracted from $matching_recovery_entry" >> "$matching_recovery_log"
      fi
