#!/bin/sh
set -eu

export LC_ALL=C

if [ "${DISTILL_GUEST:-0}" != "1" ]; then
  printf '%s\n' "bootstrap-homebrew: set DISTILL_GUEST=1 inside the macOS guest" >&2
  exit 1
fi
if [ "$(uname -s)" != "Darwin" ]; then
  printf '%s\n' "bootstrap-homebrew: Homebrew bootstrap must run in macOS" >&2
  exit 1
fi

output_dir=${1:-out/hvf}
mkdir -p "$output_dir"
brew_cmd=$(command -v brew 2>/dev/null || true)
if [ -z "$brew_cmd" ]; then
  installer=${DISTILL_HOMEBREW_INSTALLER:-}
  test -f "$installer" || {
    printf '%s\n' "bootstrap-homebrew: provide DISTILL_HOMEBREW_INSTALLER" >&2
    exit 1
  }
  /bin/bash "$installer"
  for candidate in /usr/local/bin/brew /opt/homebrew/bin/brew; do
    if [ -x "$candidate" ]; then
      PATH="$(dirname -- "$candidate"):$PATH"
      export PATH
      brew_cmd=$candidate
      break
    fi
  done
fi

if [ -z "$brew_cmd" ]; then
  printf '%s\n' "bootstrap-homebrew: brew is unavailable after bootstrap" >&2
  exit 1
fi
"$brew_cmd" --version > "$output_dir/brew-version.txt"
"$brew_cmd" config > "$output_dir/brew-config.txt"
"$brew_cmd" doctor > "$output_dir/brew-doctor.txt" 2>&1 || true
printf '%s\n' "Homebrew ready"
