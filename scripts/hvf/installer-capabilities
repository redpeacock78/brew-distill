#!/bin/sh
set -eu

export LC_ALL=C

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  printf '%s\n' "usage: installer-capabilities INSTALLER.app [output-dir]" >&2
  exit 2
fi

installer=$1
output_dir=${2:-out/hvf}
startosinstall="$installer/Contents/Resources/startosinstall"
test -x "$startosinstall" || {
  printf '%s\n' "installer-capabilities: startosinstall is unavailable: $startosinstall" >&2
  exit 1
}
plutil_cmd=${DISTILL_PLUTIL:-plutil}
command -v "$plutil_cmd" >/dev/null 2>&1 || {
  printf '%s\n' "installer-capabilities: plutil is required" >&2
  exit 1
}

mkdir -p "$output_dir"
usage_file="$output_dir/startosinstall-usage.txt"
usage_status=0
"$startosinstall" --usage > "$usage_file" 2>&1 || usage_status=$?

has_option() {
  grep -Eq -- "(^|[[:space:]])$1([[:space:],]|$)" "$usage_file"
}

agreetolicense=0
nointeraction=0
eraseinstall=0
installpackage=0
volume=0
newvolumename=0
rebootdelay=0
if has_option --agreetolicense; then agreetolicense=1; fi
if has_option --nointeraction; then nointeraction=1; fi
if has_option --eraseinstall; then eraseinstall=1; fi
if has_option --installpackage; then installpackage=1; fi
if has_option --volume; then volume=1; fi
if has_option --newvolumename; then newvolumename=1; fi
if has_option --rebootdelay; then rebootdelay=1; fi

metadata_tmp=$(mktemp "${TMPDIR:-/tmp}/brew-distill-installer-capabilities.XXXXXX")
cleanup() {
  rm -f "$metadata_tmp"
}
trap cleanup EXIT HUP INT TERM
"$plutil_cmd" -create xml1 "$metadata_tmp"
"$plutil_cmd" -insert installer -string "$installer" "$metadata_tmp"
"$plutil_cmd" -insert usage -string "$usage_file" "$metadata_tmp"
"$plutil_cmd" -insert usage_status -integer "$usage_status" "$metadata_tmp"
"$plutil_cmd" -insert options -dictionary "$metadata_tmp"
bool_value() {
  if [ "$1" -eq 1 ]; then
    printf '%s\n' true
  else
    printf '%s\n' false
  fi
}
"$plutil_cmd" -insert options.agreetolicense -bool "$(bool_value "$agreetolicense")" "$metadata_tmp"
"$plutil_cmd" -insert options.nointeraction -bool "$(bool_value "$nointeraction")" "$metadata_tmp"
"$plutil_cmd" -insert options.eraseinstall -bool "$(bool_value "$eraseinstall")" "$metadata_tmp"
"$plutil_cmd" -insert options.installpackage -bool "$(bool_value "$installpackage")" "$metadata_tmp"
"$plutil_cmd" -insert options.volume -bool "$(bool_value "$volume")" "$metadata_tmp"
"$plutil_cmd" -insert options.newvolumename -bool "$(bool_value "$newvolumename")" "$metadata_tmp"
"$plutil_cmd" -insert options.rebootdelay -bool "$(bool_value "$rebootdelay")" "$metadata_tmp"
"$plutil_cmd" -convert json -o "$output_dir/installer-capabilities.json" "$metadata_tmp"

if [ "$usage_status" -ne 0 ]; then
  printf '%s\n' "installer-capabilities: startosinstall --usage failed" >&2
  exit "$usage_status"
fi

printf '%s\n' "saved $output_dir/installer-capabilities.json"
