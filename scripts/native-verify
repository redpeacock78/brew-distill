#!/bin/sh
set -eu

export LC_ALL=C

if [ "$#" -ne 4 ]; then
  printf '%s\n' "usage: native-verify FORMULA BOTTLE EXPECTED_SHA256 OUTPUT-DIR" >&2
  exit 2
fi
formula=$1
bottle=$2
expected=$3
output_dir=$4
case "$formula" in
  ''|-*|*[!A-Za-z0-9@+._/-]*)
    printf '%s\n' "native-verify: unsafe formula name: $formula" >&2
    exit 2
    ;;
esac
safe_name=$(printf '%s' "$formula" | tr '/@+' '___')
case "$expected" in
  ''|*[!0-9a-fA-F]*)
    printf '%s\n' "native-verify: invalid expected SHA256" >&2
    exit 2
    ;;
esac
if [ "${#expected}" -ne 64 ]; then
  printf '%s\n' "native-verify: invalid expected SHA256" >&2
  exit 2
fi
test -f "$bottle" || {
  printf '%s\n' "native-verify: Bottle does not exist: $bottle" >&2
  exit 1
}
bottle_dir=$(cd -- "$(dirname -- "$bottle")" && pwd)
bottle_name=$(basename -- "$bottle")
bottle="$bottle_dir/$bottle_name"
command -v brew >/dev/null 2>&1 || {
  printf '%s\n' "native-verify: brew is required" >&2
  exit 1
}
command -v shasum >/dev/null 2>&1 || {
  printf '%s\n' "native-verify: shasum is required" >&2
  exit 1
}

if [ "${DISTILL_RELEASE_BUILD:-0}" = "1" ]; then
  case "${HOMEBREW_ARTIFACT_DOMAIN:-}" in
    https://?*) ;;
    *)
      printf '%s\n' "native-verify: release verification requires HTTPS HOMEBREW_ARTIFACT_DOMAIN" >&2
      exit 2
      ;;
  esac
  [ "${HOMEBREW_ARTIFACT_DOMAIN_NO_FALLBACK:-0}" = "1" ] || {
    printf '%s\n' "native-verify: release verification requires HOMEBREW_ARTIFACT_DOMAIN_NO_FALLBACK=1" >&2
    exit 2
  }
fi

actual=$(shasum -a 256 "$bottle" | awk '{print $1}')
expected=$(printf '%s' "$expected" | tr '[:upper:]' '[:lower:]')
if [ "$actual" != "$expected" ]; then
  printf '%s\n' "native-verify: Bottle SHA256 mismatch" >&2
  exit 1
fi

mkdir -p "$output_dir"
installed=$(brew list --formula --versions 2>/dev/null || true)
if printf '%s\n' "$installed" | awk -v formula="$formula" '$1 == formula { found=1 } END { exit found ? 0 : 1 }'; then
  printf '%s\n' "native-verify: formula is already installed; use a fresh runner" >&2
  exit 1
fi

export HOMEBREW_NO_AUTO_UPDATE="${HOMEBREW_NO_AUTO_UPDATE:-1}"
(
  cd -- "$bottle_dir"
  HOMEBREW_DEVELOPER=1 brew install --formula "./$bottle_name"
)
brew test "$formula" > "$output_dir/$safe_name.test.txt" 2>&1
brew linkage --test "$formula" > "$output_dir/$safe_name.linkage.txt" 2>&1
installed=$(brew list --formula --versions 2>/dev/null || true)
printf '%s\n' "$installed" | awk -v formula="$formula" '$1 == formula { found=1 } END { exit found ? 0 : 1 }' || {
  printf '%s\n' "native-verify: Homebrew did not report $formula after installation" >&2
  exit 1
}

if [ "$formula" = "csound" ]; then
  repo_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
  csound_bin=$(brew --prefix "$formula")/bin/csound
  "$csound_bin" -d -o "$output_dir/csound.smoke.wav" "$repo_dir/tests/smoke.csd"
  test -s "$output_dir/csound.smoke.wav"
fi

printf '%s\n' "formula=$formula" "bottle=$bottle" "sha256=$actual" > "$output_dir/native-verification.txt"
printf '%s\n' "native verification passed: $formula"
